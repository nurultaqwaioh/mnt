---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Kajian from '../components/Kajian.astro';
import Zis from '../components/Zis.astro';
import UnitBisnis from '../components/UnitBisnis.astro';
import Berita from '../components/Berita.astro';
import ArtikelSection from '../components/ArtikelSection.astro'; // Seksi Baru: Berita, Fikih, Sirah & eBook
import Laporan from '../components/Laporan.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Masjid Nurul Taqwa PT Indosat Tbk - Portal Dakwah & Kebaikan">
  <Header />
  <main class="w-full pt-20 bg-surface min-h-screen">
    <Hero />
    <Kajian />
    <Zis />
    <ArtikelSection />
    <UnitBisnis />
    <Berita />
    <Laporan />
    
  </main>
  <Footer />
</Layout>
