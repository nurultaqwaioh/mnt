---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { artikelData, type ArtikelItem } from '../../data/artikel';

export function getStaticPaths() {
  return artikelData.map((artikel) => ({
    params: { slug: artikel.slug },
    props: { artikel },
  }));
}

interface Props {
  artikel: ArtikelItem;
}

const { artikel } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const relatedArticles = artikelData.filter((a) => a.slug !== artikel.slug).slice(0, 3);
---

<Layout title={`${artikel.title} - Pustaka Masjid Nurul Taqwa`}>
  <Header />

  <main class="w-full pt-20 bg-surface min-h-screen">
    <!-- Header Artikel -->
    <section class="w-full bg-[#033823] text-white py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-margin md:px-margin-md flex flex-col gap-5">
        <div class="flex flex-wrap items-center gap-2 text-xs font-label text-zinc-300">
          <a href={`${baseUrl}/`} class="hover:text-[#C5A059] transition-colors">Beranda</a>
          <span>/</span>
          <a href={`${baseUrl}/artikel`} class="hover:text-[#C5A059] transition-colors">Pustaka & Artikel</a>
          <span>/</span>
          <span class="text-[#C5A059] font-semibold">{artikel.category}</span>
        </div>

        <div class="flex items-center gap-3">
          <span class="px-3 py-1 rounded-lg bg-[#C5A059] text-emerald-950 font-label text-xs font-extrabold uppercase tracking-wider">
            {artikel.category}
          </span>
          <span class="font-label text-xs text-zinc-300">{artikel.date} &bull; {artikel.readTime}</span>
        </div>

        <h1 class="font-display text-2xl sm:text-4xl font-bold leading-tight">
          {artikel.title}
        </h1>

        <!-- Info Penulis / Pemateri -->
        <div class="flex items-center gap-3 pt-2 border-t border-white/15">
          <div class="w-10 h-10 rounded-full bg-white/10 text-[#C5A059] flex items-center justify-center">
            <span class="material-symbols-outlined">person</span>
          </div>
          <div class="flex flex-col">
            <span class="font-display text-sm font-bold text-white">{artikel.author}</span>
            <span class="font-label text-xs text-zinc-300">{artikel.authorRole}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Isi Artikel & Box Unduh eBook -->
    <section class="max-w-4xl mx-auto px-margin md:px-margin-md py-10 flex flex-col gap-8">
      <!-- Gambar Utama -->
      <div class="rounded-2xl overflow-hidden shadow-lg h-64 sm:h-96 bg-zinc-200">
        <img src={artikel.image} alt={artikel.title} class="w-full h-full object-cover" />
      </div>

      <!-- Jika Kategori eBook: Tampilkan Panel Download PDF -->
      {artikel.category === 'eBook' && artikel.ebookMeta && (
        <div class="p-6 rounded-2xl bg-gradient-to-r from-[#033823] to-emerald-900 text-white shadow-md flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-[#C5A059] text-emerald-950 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-3xl">picture_as_pdf</span>
            </div>
            <div class="flex flex-col gap-1">
              <span class="font-label text-[11px] uppercase tracking-wider text-[#C5A059] font-bold">Dokumen eBook Resmi</span>
              <h2 class="font-display text-lg font-bold">Unduh E-Book PDF Gratis</h2>
              <span class="font-label text-xs text-zinc-200">
                Spesifikasi: {artikel.ebookMeta.pages} &bull; Ukuran: {artikel.ebookMeta.fileSize}
              </span>
            </div>
          </div>

          <a 
            href={artikel.ebookMeta.downloadUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-3 rounded-xl bg-[#C5A059] hover:bg-[#fed488] text-emerald-950 font-display text-xs font-extrabold flex items-center gap-2 shrink-0 transition-all"
          >
            <span class="material-symbols-outlined text-[18px]">download</span>
            <span>Download PDF</span>
          </a>
        </div>
      )}

      <!-- Paragraf Konten Bacaan -->
      <div class="bg-surface-container-lowest p-6 sm:p-8 rounded-2xl border border-zinc-200/80 shadow-xs flex flex-col gap-5">
        <p class="font-display text-base sm:text-lg font-semibold text-primary leading-relaxed border-l-4 border-primary pl-4">
          {artikel.excerpt}
        </p>

        {artikel.content.map((paragraph) => (
          <p class="font-body text-base text-on-surface leading-relaxed">
            {paragraph}
          </p>
        ))}
      </div>

      <!-- Bacaan Terkait Lainnya -->
      <div class="pt-8 border-t border-zinc-200 flex flex-col gap-5">
        <div class="flex items-center justify-between">
          <h3 class="font-display text-xl font-bold text-on-surface">Bacaan & Pustaka Lainnya</h3>
          <a href={`${baseUrl}/artikel`} class="font-label text-xs font-bold text-primary hover:underline">
            Lihat Semua Katalog &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {relatedArticles.map((rel) => (
            <a 
              href={`${baseUrl}/artikel/${rel.slug}`}
              class="p-4 rounded-xl bg-surface-container-lowest border border-zinc-200/70 hover:border-primary/40 flex flex-col justify-between gap-2 group transition-all"
            >
              <span class="font-label text-[10px] font-bold uppercase text-secondary-gold">{rel.category}</span>
              <h4 class="font-display text-sm font-bold text-on-surface group-hover:text-primary transition-colors line-clamp-2">
                {rel.title}
              </h4>
              <span class="font-label text-[11px] text-on-surface-variant">{rel.date}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
