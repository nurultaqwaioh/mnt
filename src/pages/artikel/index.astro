---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { artikelData } from '../../data/artikel';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = [
  { key: 'Semua', label: 'Semua Kategori', icon: 'apps' },
  { key: 'Berita', label: 'Berita Masjid', icon: 'newspaper' },
  { key: 'Fikih', label: 'Kajian Fikih', icon: 'balance' },
  { key: 'Sirah', label: 'Sirah Nabawiyah', icon: 'history_edu' },
  { key: 'eBook', label: 'Katalog eBook PDF', icon: 'picture_as_pdf' },
];
---

<Layout title="Pustaka Artikel, Fikih, Sirah & eBook - Masjid Nurul Taqwa">
  <Header />

  <main class="w-full pt-20 bg-surface min-h-screen">
    <!-- Hero Header Pustaka -->
    <section class="w-full bg-[#033823] text-white py-14 lg:py-16">
      <div class="max-w-7xl mx-auto px-margin md:px-margin-md lg:px-margin-lg flex flex-col gap-5">
        <div class="flex items-center gap-2 text-xs font-label text-zinc-300">
          <a href={`${baseUrl}/`} class="hover:text-[#C5A059] flex items-center gap-1 transition-colors">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            <span>Beranda</span>
          </a>
          <span>/</span>
          <span class="text-[#C5A059] font-semibold">Pustaka & Literasi</span>
        </div>

        <div class="max-w-3xl flex flex-col gap-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 text-[#C5A059] font-label text-xs font-bold uppercase tracking-wider w-fit">
            <span class="material-symbols-outlined text-[15px]">auto_stories</span>
            Pusat Literasi Islam Korporat
          </span>
          <h1 class="font-display text-3xl md:text-5xl font-bold leading-tight">
            Berita, Fikih, Sirah & eBook Digital
          </h1>
          <p class="font-body text-sm md:text-base text-zinc-200 leading-relaxed">
            Tingkatkan khazanah keislaman Anda melalui artikel fikih kontemporer, kisah keteladanan sirah, kabar kegiatan Masjid Nurul Taqwa, dan eBook gratis.
          </p>
        </div>

        <!-- Bar Pencarian & Filter Kategori -->
        <div class="pt-4 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-2">
            {categories.map((cat, idx) => (
              <button
                type="button"
                data-cat={cat.key}
                class={`catalog-filter-btn inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl font-label text-xs font-bold transition-all cursor-pointer ${
                  idx === 0
                    ? 'bg-[#C5A059] text-emerald-950 shadow-sm'
                    : 'bg-white/10 text-white hover:bg-white/20'
                }`}
              >
                <span class="material-symbols-outlined text-[16px]">{cat.icon}</span>
                <span>{cat.label}</span>
              </button>
            ))}
          </div>

          <div class="relative w-full md:w-72">
            <input 
              id="catalog-search-input"
              type="text" 
              placeholder="Cari judul artikel atau eBook..." 
              class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-white/10 border border-white/20 text-white placeholder-zinc-300 text-xs font-body focus:outline-none focus:border-[#C5A059]"
            />
            <span class="material-symbols-outlined text-[18px] text-zinc-300 absolute left-3 top-1/2 -translate-y-1/2">search</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Daftar Artikel & eBook -->
    <section class="max-w-7xl mx-auto px-margin md:px-margin-md lg:px-margin-lg py-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="catalog-grid">
        {artikelData.map((item) => (
          <article 
            data-cat={item.category}
            data-title={item.title.toLowerCase()}
            class="catalog-item rounded-2xl bg-surface-container-lowest border border-zinc-200/80 hover:border-primary/40 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between overflow-hidden group"
          >
            <div>
              <a href={`${baseUrl}/artikel/${item.slug}`} class="block relative h-52 w-full bg-zinc-200 overflow-hidden">
                <img src={item.image} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-transparent"></div>
                <span class={`absolute top-3 left-3 px-3 py-1 rounded-lg font-label text-[10px] font-extrabold uppercase tracking-wider ${
                  item.category === 'eBook' ? 'bg-[#C5A059] text-emerald-950' : 'bg-white text-primary'
                }`}>
                  {item.category}
                </span>
                <span class="absolute bottom-3 right-3 px-2.5 py-1 rounded-md bg-black/60 text-white font-label text-[10px] font-semibold">
                  {item.readTime}
                </span>
              </a>

              <div class="p-5 flex flex-col gap-2.5">
                <div class="flex items-center justify-between text-[11px] font-label text-on-surface-variant">
                  <span>{item.date}</span>
                  <span class="font-semibold text-primary truncate max-w-[160px]">{item.author}</span>
                </div>
                <a href={`${baseUrl}/artikel/${item.slug}`}>
                  <h2 class="font-display text-lg font-bold text-on-surface group-hover:text-primary transition-colors leading-snug">
                    {item.title}
                  </h2>
                </a>
                <p class="font-body text-xs text-on-surface-variant leading-relaxed line-clamp-3">
                  {item.excerpt}
                </p>
              </div>
            </div>

            <div class="px-5 pb-5 pt-2">
              <a 
                href={`${baseUrl}/artikel/${item.slug}`}
                class="w-full py-2.5 px-4 rounded-xl bg-surface-container-low group-hover:bg-primary group-hover:text-on-primary text-primary font-display text-xs font-bold flex items-center justify-between transition-colors"
              >
                <span>{item.category === 'eBook' ? 'Lihat Detail & Unduh PDF' : 'Baca Artikel Penuh'}</span>
                <span class="material-symbols-outlined text-[16px]">
                  {item.category === 'eBook' ? 'download' : 'arrow_forward'}
                </span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline>
  (function initCatalogFilter() {
    const btns = document.querySelectorAll('.catalog-filter-btn');
    const searchInput = document.getElementById('catalog-search-input');
    const items = document.querySelectorAll('.catalog-item');
    let activeCat = 'Semua';

    function filterItems() {
      const query = (searchInput?.value || '').toLowerCase();
      items.forEach((el) => {
        const cat = el.getAttribute('data-cat');
        const title = el.getAttribute('data-title') || '';
        const matchCat = activeCat === 'Semua' || cat === activeCat;
        const matchSearch = title.includes(query);

        if (matchCat && matchSearch) {
          el.classList.remove('hidden');
          el.classList.add('flex');
        } else {
          el.classList.remove('flex');
          el.classList.add('hidden');
        }
      });
    }

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCat = btn.getAttribute('data-cat') || 'Semua';
        btns.forEach((b) => {
          b.className = 'catalog-filter-btn inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl font-label text-xs font-bold transition-all cursor-pointer bg-white/10 text-white hover:bg-white/20';
        });
        btn.className = 'catalog-filter-btn inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl font-label text-xs font-bold transition-all cursor-pointer bg-[#C5A059] text-emerald-950 shadow-sm';
        filterItems();
      });
    });

    searchInput?.addEventListener('input', filterItems);
  })();
</script>
