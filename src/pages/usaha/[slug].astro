---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { usahaData, type UsahaItem } from '../../data/usaha';

export function getStaticPaths() {
  return usahaData.map((usaha) => ({
    params: { slug: usaha.slug },
    props: { usaha },
  }));
}

interface Props {
  usaha: UsahaItem;
}

const { usaha } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`${usaha.title} - Unit Usaha Masjid Nurul Taqwa`}>
  <Header />

  <main class="w-full pt-20 bg-surface min-h-screen">
    <!-- Hero Banner -->
    <section class="relative w-full bg-[#033823] text-white py-14 lg:py-20 overflow-hidden">
      <div class="max-w-7xl mx-auto px-margin md:px-margin-md lg:px-margin-lg relative z-10 flex flex-col gap-6">
        <div class="flex items-center gap-2 text-xs font-label text-zinc-300">
          <a href={`${baseUrl}/`} class="hover:text-[#C5A059] flex items-center gap-1 transition-colors">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            <span>Kembali ke Beranda</span>
          </a>
          <span>/</span>
          <span class="text-[#C5A059] font-semibold">{usaha.title}</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 flex flex-col gap-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-[#C5A059] font-label text-xs font-bold uppercase tracking-wider w-fit">
              <span class="material-symbols-outlined text-[16px]">{usaha.icon}</span>
              <span>{usaha.category} &bull; {usaha.badge}</span>
            </div>
            <h1 class="font-display text-3xl md:text-5xl font-bold leading-tight">{usaha.title}</h1>
            {usaha.tagline && <p class="font-display text-lg lg:text-xl text-[#C5A059] italic font-semibold">{usaha.tagline}</p>}
            <p class="font-body text-base text-zinc-200 leading-relaxed">{usaha.shortDesc}</p>
          </div>
          <div class="lg:col-span-5">
            <div class="rounded-2xl overflow-hidden shadow-2xl border-2 border-white/15 h-64 md:h-80 bg-zinc-800">
              <img src={usaha.image} alt={usaha.title} class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Content Area -->
    <section class="max-w-7xl mx-auto px-margin md:px-margin-md lg:px-margin-lg py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- Left Side: Detail & Penjelasan -->
        <div class="lg:col-span-7 flex flex-col gap-8">
          <div class="flex flex-col gap-4">
            <h2 class="font-display text-2xl font-bold text-on-surface">Profil & Visi Misi</h2>
            <p class="font-body text-base text-on-surface-variant leading-relaxed">{usaha.fullDesc}</p>
          </div>

          <!-- DETAIL KHUSUS BBNT (DARI PDF) -->
          {usaha.slug === 'bbnt' && (
            <div class="flex flex-col gap-8">
              <!-- Legalitas BBNT -->
              <div class="p-6 rounded-2xl bg-surface-container-low border border-zinc-200/50 flex flex-col gap-4">
                <h3 class="font-display text-lg font-bold text-on-surface flex items-center gap-2">
                  <span class="material-symbols-outlined text-primary">gavel</span>
                  <span>Informasi Legalitas Hukum</span>
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-body text-on-surface-variant">
                  <div><strong>Badan Hukum:</strong> {usaha.legalitas?.badanHukum}</div>
                  <div><strong>Bidang Usaha:</strong> {usaha.legalitas?.bidangUsaha}</div>
                  <div><strong>Tanggal Berdiri:</strong> {usaha.legalitas?.tglBerdiri}</div>
                  <div><strong>No. Akta Pendirian:</strong> {usaha.legalitas?.noAkta}</div>
                  <div class="sm:col-span-2"><strong>Notaris:</strong> {usaha.legalitas?.notaris}</div>
                  <div class="sm:col-span-2"><strong>Alamat Sekretariat:</strong> {usaha.legalitas?.alamat}</div>
                </div>
              </div>

              <!-- Manajemen BBNT -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="p-5 rounded-xl border border-zinc-200/70">
                  <h4 class="font-display text-sm font-bold text-primary mb-3">Dewan Pengawas Syariah</h4>
                  <ul class="list-disc pl-5 text-xs text-on-surface-variant flex flex-col gap-1.5">
                    {usaha.manajemen?.pengawasSyariah.map(item => <li>{item}</li>)}
                  </ul>
                </div>
                <div class="p-5 rounded-xl border border-zinc-200/70">
                  <h4 class="font-display text-sm font-bold text-primary mb-3">Badan Pengurus Harian</h4>
                  <ul class="list-disc pl-5 text-xs text-on-surface-variant flex flex-col gap-1.5">
                    {usaha.manajemen?.pengurusHarian.map(item => <li>{item}</li>)}
                  </ul>
                </div>
              </div>

              <!-- Syarat Keanggotaan BBNT -->
              <div class="p-6 rounded-2xl bg-white border border-zinc-200 flex flex-col gap-4">
                <h3 class="font-display text-lg font-bold text-on-surface flex items-center gap-2">
                  <span class="material-symbols-outlined text-[#C5A059]">verified_user</span>
                  <span>Syarat Keanggotaan BBNT</span>
                </h3>
                <ol class="list-decimal pl-5 text-sm text-on-surface-variant flex flex-col gap-2">
                  {usaha.syaratAnggota?.map(item => <li>{item}</li>)}
                </ol>
              </div>

              <!-- Jajaran Produk Syariah BBNT -->
              <div class="p-6 rounded-2xl bg-zinc-900 text-white flex flex-col gap-4">
                <h3 class="font-display text-lg font-bold text-[#C5A059] flex items-center gap-2">
                  <span class="material-symbols-outlined">payments</span>
                  <span>Solusi Produk & Layanan Syariah</span>
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                  <div class="flex flex-col gap-1">
                    <span class="font-semibold text-zinc-400">Simpanan & Tabungan:</span>
                    <p class="text-zinc-200">{usaha.produkLayanan?.simpanan.join(', ')} • {usaha.produkLayanan?.tabungan.join(', ')}</p>
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="font-semibold text-zinc-400">Deposito & Pembiayaan:</span>
                    <p class="text-zinc-200">{usaha.produkLayanan?.deposito.join(', ')} • {usaha.produkLayanan?.pembiayaan.join(', ')}</p>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>

        <!-- Right Side: Sidebar Informasi Pendaftaran -->
        <div class="lg:col-span-5">
          <div class="p-6 rounded-2xl bg-surface-container-lowest border border-zinc-200 shadow-sm flex flex-col gap-4 sticky top-28">
            <span class="font-label text-xs font-bold uppercase tracking-wider text-primary">Layanan Interaktif</span>
            <h3 class="font-display text-lg font-bold text-on-surface">Hubungi Pengurus / Admin</h3>
            <p class="font-body text-xs text-on-surface-variant leading-relaxed">
              Dapatkan informasi pendaftaran anggota, simulasi pembiayaan, atau konsultasi program usaha.
            </p>
            <a href={`https://wa.me/${usaha.whatsapp}`} target="_blank" rel="noopener noreferrer" class="w-full py-3 px-4 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-display text-xs font-bold text-center transition-all flex items-center justify-center gap-2">
              <span class="material-symbols-outlined text-[16px]">chat</span>
              <span>Hubungi Lewat WhatsApp</span>
            </a>
            {usaha.website && (
              <a href={`https://${usaha.website}`} target="_blank" class="text-xs text-primary font-semibold text-center hover:underline">
                Kunjungi Official Website ({usaha.website})
              </a>
            )}
          </div>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>
