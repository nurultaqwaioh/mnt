---
import { Image } from 'astro:assets';
import logo from '../images/logoMNT.png';

const navLinks = [
  { name: 'Beranda', href: '#hero', icon: 'home' },
  { name: 'Jadwal Kajian', href: '#jadwal-kajian', icon: 'menu_book' },
  { name: 'ZIS', href: '#zis', icon: 'volunteer_activism' },
  { name: 'Unit Bisnis', href: '#unit-bisnis', icon: 'storefront' },
  { name: 'Artikel', href: '#berita-artikel', icon: 'newspaper' },
  { name: 'Laporan', href: '#laporan', icon: 'receipt_long' },
  { name: 'Kontak', href: '#kontak', icon: 'contacts' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_12px_rgba(0,0,0,0.06)] border-b border-surface-container">
  <div class="h-20 max-w-7xl mx-auto px-margin md:px-margin-md lg:px-margin-lg flex items-center justify-between gap-gutter">
    
    <!-- Brand Logo -->
    <a class="flex items-center gap-space-sm shrink-0 group" href="#hero">
      <div class="w-10 h-10 rounded-xl bg-primary-container text-on-primary flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform">
        <Image src={logo} alt="Logo Masjid Nurul Taqwa" width={32} height={32} class="hidden sm:inline-block" />
      </div>
      <div class="flex flex-col">
       
        <span class="font-display text-lg lg:text-xl font-bold text-primary tracking-tight leading-none">Masjid Nurul Taqwa</span>
        <span class="font-label text-[10px] text-secondary-gold uppercase tracking-wider font-semibold">PT Indosat Tbk</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden xl:flex items-center gap-1.5">
      {navLinks.map((link) => (
        <a 
          class="px-3.5 py-2 font-label text-sm font-medium text-on-surface-variant hover:text-primary hover:bg-surface-container-low transition-colors rounded-lg" 
          href={link.href}
        >
          {link.name}
        </a>
      ))}
    </nav>

    <!-- Right Side Actions & Hamburger Trigger -->
    <div class="flex items-center gap-2 sm:gap-space-sm shrink-0">
      <a class="hidden sm:inline-flex items-center gap-space-xs px-4 py-2.5 bg-primary-container text-on-primary font-label text-sm font-semibold rounded-lg shadow-sm hover:bg-primary transition-all duration-200 active:scale-95" href="#zis">
        <span class="material-symbols-outlined text-[18px]">volunteer_activism</span>
        <span>Donasi / ZIS</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobile-menu-btn" 
        class="xl:hidden w-11 h-11 flex items-center justify-center rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface transition-colors focus:outline-none focus:ring-2 focus:ring-primary" 
        aria-label="Buka Menu Navigasi"
        aria-expanded="false"
      >
        <span class="material-symbols-outlined text-[26px]">menu</span>
      </button>
    </div>
  </div>
</header>

<!-- Backdrop Overlay -->
<div 
  id="drawer-backdrop" 
  class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 xl:hidden"
  aria-hidden="true"
></div>

<!-- Mobile Drawer Sidebar -->
<aside 
  id="mobile-drawer" 
  class="fixed top-0 right-0 z-50 h-full w-[85%] max-w-sm bg-surface-container-lowest shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col justify-between xl:hidden"
  aria-label="Mobile Navigation Drawer"
>
  <!-- Drawer Header -->
  <div class="p-5 border-b border-surface-container flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <div class="w-9 h-9 rounded-lg bg-primary-container text-on-primary flex items-center justify-center">
        <span class="material-symbols-outlined text-[20px]">mosque</span>
      </div>
      <div class="flex flex-col">
        <span class="font-display text-base font-bold text-primary leading-none">Menu Navigasi</span>
        <span class="font-label text-[10px] text-secondary-gold uppercase">Masjid Nurul Taqwa</span>
      </div>
    </div>
    
    <button 
      id="close-drawer-btn" 
      class="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-surface-container text-on-surface-variant hover:text-on-surface transition-colors" 
      aria-label="Tutup Menu"
    >
      <span class="material-symbols-outlined text-[24px]">close</span>
    </button>
  </div>

  <!-- Drawer Menu Links -->
  <nav class="flex-1 overflow-y-auto p-4 flex flex-col gap-1">
    {navLinks.map((link) => (
      <a 
        class="drawer-link flex items-center gap-3.5 px-4 py-3 rounded-xl font-label text-sm font-semibold text-on-surface-variant hover:text-primary hover:bg-surface-container transition-all active:scale-[0.98]" 
        href={link.href}
      >
        <span class="material-symbols-outlined text-primary text-[22px]">{link.icon}</span>
        <span>{link.name}</span>
      </a>
    ))}
  </nav>

  <!-- Drawer Footer Action -->
  <div class="p-5 border-t border-surface-container bg-surface-container-low flex flex-col gap-3">
    <a 
      class="drawer-link w-full py-3 px-4 bg-primary text-on-primary font-display font-semibold rounded-xl text-center shadow-md flex items-center justify-center gap-2 active:scale-95 transition-all" 
      href="#zis"
    >
      <span class="material-symbols-outlined text-[20px]">volunteer_activism</span>
      <span>Salurkan ZIS / Donasi</span>
    </a>
    <p class="font-label text-[11px] text-center text-on-surface-variant">
      Lantai 4 Kantor Pusat PT Indosat Tbk
    </p>
  </div>
</aside>

<script is:inline>
  const openBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('close-drawer-btn');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('drawer-backdrop');
  const drawerLinks = document.querySelectorAll('.drawer-link');

  function openDrawer() {
    drawer.classList.remove('translate-x-full');
    drawer.classList.add('translate-x-0');
    backdrop.classList.remove('opacity-0', 'pointer-events-none');
    backdrop.classList.add('opacity-100', 'pointer-events-auto');
    document.body.style.overflow = 'hidden';
    openBtn?.setAttribute('aria-expanded', 'true');
  }

  function closeDrawer() {
    drawer.classList.remove('translate-x-0');
    drawer.classList.add('translate-x-full');
    backdrop.classList.remove('opacity-100', 'pointer-events-auto');
    backdrop.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
    openBtn?.setAttribute('aria-expanded', 'false');
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  // Auto-close drawer saat salah satu menu diklik
  drawerLinks.forEach((link) => {
    link.addEventListener('click', closeDrawer);
  });

  // Tutup dengan tombol keyboard ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !drawer?.classList.contains('translate-x-full')) {
      closeDrawer();
    }
  });
</script>
