---
import { Image } from 'astro:assets';
import logoBSI from '../images/Bank_Syariah_Indonesia.svg';

// Import aset logo dari src/images/
// Sesuaikan nama file dan ekstensi (.png / .svg / .webp) dengan file asli Anda di src/images/
import logoSKI from '../images/Logo SKI.svg';
import logoIOH from '../images/Logo IOH Black Partnership.png';

const quickLinks = [
  { name: 'Beranda', href: '#hero' },
  { name: 'Jadwal Kajian', href: '#jadwal-kajian' },
  { name: 'Layanan ZIS', href: '#zis' },
  { name: 'Unit Bisnis', href: '#unit-bisnis' },
  { name: 'Artikel & Berita', href: '#berita-artikel' },
  { name: 'Laporan Keuangan', href: '#laporan' },
];
---

<footer class="w-full bg-surface-container-low text-on-surface border-t border-zinc-200/80 pt-14 pb-8" id="kontak">
  <div class="max-w-7xl mx-auto px-margin md:px-margin-md lg:px-margin-lg flex flex-col gap-12">
    
    <!-- MAIN FOOTER GRID (12 Kolom) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10">
      
      <!-- KOLOM 1 (4/12): Identitas Masjid, Alamat & Sosial Media -->
      <div class="lg:col-span-4 flex flex-col gap-5">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-primary text-on-primary flex items-center justify-center shadow-sm shrink-0">
            <span class="material-symbols-outlined text-[26px]">mosque</span>
          </div>
          <div class="flex flex-col">
            <span class="font-display text-xl font-bold text-primary tracking-tight leading-none">
              Masjid Nurul Taqwa
            </span>
            <span class="font-label text-[11px] text-secondary-gold uppercase tracking-wider font-semibold mt-1">
              Indosat Ooredoo Hutchison
            </span>
          </div>
        </div>

        <p class="font-body text-sm text-on-surface-variant leading-relaxed">
          Pusat pembinaan spiritual, dakwah kontemporer, dan pemberdayaan umat di lingkungan Kantor Pusat PT Indosat Tbk.
        </p>

        <!-- Alamat Lengkap -->
        <div class="flex items-start gap-3 p-3.5 rounded-xl bg-surface-container-lowest border border-zinc-200/60 shadow-2xs">
          <span class="material-symbols-outlined text-primary text-[22px] shrink-0 mt-0.5">location_on</span>
          <div class="flex flex-col gap-0.5">
            <span class="font-display text-xs font-bold text-on-surface uppercase tracking-wider">Alamat Sekretariat MNT</span>
            <p class="font-body text-xs text-on-surface-variant leading-relaxed">
              Jl. Medan Merdeka Barat No. 21, Gambir, Kecamatan Gambir, Kota Jakarta Pusat, DKI Jakarta 10110
            </p>
          </div>
        </div>

        <!-- Social Media (YouTube & Instagram Saja) -->
        <div class="flex flex-col gap-2">
          <span class="font-label text-xs font-semibold text-on-surface-variant uppercase tracking-wider">
            Ikuti Media Sosial Kami
          </span>
          <div class="flex items-center gap-3">
            <!-- YouTube -->
            <a 
              href="https://youtube.com" 
              target="_blank" 
              rel="noopener noreferrer"
              aria-label="YouTube Masjid Nurul Taqwa"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-surface-container-lowest hover:bg-[#FF0000] text-on-surface hover:text-white border border-zinc-200/80 shadow-2xs transition-all duration-200 group"
            >
              <svg class="w-5 h-5 fill-current text-[#FF0000] group-hover:text-white transition-colors" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              <span class="font-label text-xs font-semibold">YouTube</span>
            </a>

            <!-- Instagram -->
            <a 
              href="https://instagram.com" 
              target="_blank" 
              rel="noopener noreferrer"
              aria-label="Instagram Masjid Nurul Taqwa"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-surface-container-lowest hover:bg-gradient-to-tr hover:from-[#f09433] hover:via-[#dc2743] hover:to-[#bc1888] text-on-surface hover:text-white border border-zinc-200/80 shadow-2xs transition-all duration-200 group"
            >
              <svg class="w-5 h-5 fill-current text-[#E1306C] group-hover:text-white transition-colors" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span class="font-label text-xs font-semibold">Instagram</span>
            </a>
          </div>
        </div>
      </div>

      <!-- KOLOM 2 (4/12): Hubungi Kami & Navigasi Cepat -->
      <div class="lg:col-span-4 flex flex-col justify-between gap-6">
        <div class="flex flex-col gap-4">
          <h3 class="font-display text-base font-bold text-on-surface uppercase tracking-wider border-b border-zinc-200 pb-2">
            Hubungi Sekretariat
          </h3>

          <div class="flex flex-col gap-3">
            <!-- Native Email Link (mailto:) -->
            <a 
              href="mailto:masjidnurultaqwa@ioh.co.id?subject=Pertanyaan%20/%20Layanan%20Masjid%20Nurul%20Taqwa" 
              class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-lowest hover:bg-primary hover:text-on-primary border border-zinc-200/70 transition-all duration-200 group shadow-2xs"
            >
              <div class="w-9 h-9 rounded-lg bg-primary/10 group-hover:bg-white/20 text-primary group-hover:text-white flex items-center justify-center transition-colors shrink-0">
                <span class="material-symbols-outlined text-[20px]">mail</span>
              </div>
              <div class="flex flex-col min-w-0">
                <span class="font-label text-[10px] uppercase tracking-wider text-on-surface-variant group-hover:text-white/80">
                  Kirim Email Resmi (Klik untuk Buka Email)
                </span>
                <span class="font-display text-xs sm:text-sm font-bold truncate">
                  masjidnurultaqwa@ioh.co.id
                </span>
              </div>
            </a>

            <!-- Nomor Hotline 1 -->
            <a 
              href="https://wa.me/6281585079225" 
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-lowest hover:border-primary/40 border border-zinc-200/70 transition-all duration-200 group shadow-2xs"
            >
              <div class="w-9 h-9 rounded-lg bg-green-500/10 text-green-700 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[20px]">call</span>
              </div>
              <div class="flex flex-col">
                <span class="font-label text-[10px] uppercase tracking-wider text-on-surface-variant">
                  Hotline Layanan Jamaah 1 (WA / Telp)
                </span>
                <span class="font-display text-sm font-bold text-on-surface group-hover:text-primary transition-colors">
                  +62 815-8507-9225
                </span>
              </div>
            </a>

            <!-- Nomor Hotline 2 -->
            <a 
              href="https://wa.me/6285600001567" 
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-lowest hover:border-primary/40 border border-zinc-200/70 transition-all duration-200 group shadow-2xs"
            >
              <div class="w-9 h-9 rounded-lg bg-green-500/10 text-green-700 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[20px]">support_agent</span>
              </div>
              <div class="flex flex-col">
                <span class="font-label text-[10px] uppercase tracking-wider text-on-surface-variant">
                  Hotline Layanan Jamaah 2 (WA / Telp)
                </span>
                <span class="font-display text-sm font-bold text-on-surface group-hover:text-primary transition-colors">
                  +62 856-0000-1567
                </span>
              </div>
            </a>
          </div>
        </div>

        <!-- Quick Links -->
        <div class="flex flex-col gap-2">
          <span class="font-label text-xs font-bold text-on-surface uppercase tracking-wider">Tautan Cepat</span>
          <div class="grid grid-cols-2 gap-x-4 gap-y-1.5">
            {quickLinks.map((link) => (
              <a 
                href={link.href} 
                class="font-body text-xs text-on-surface-variant hover:text-primary transition-colors flex items-center gap-1"
              >
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span>{link.name}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- KOLOM 3 (4/12): Rekening Sedekah Operasional Masjid (BSI) -->
      <div class="lg:col-span-4 flex flex-col">
        <div class="h-full rounded-2xl bg-surface-container-lowest p-6 border-2 border-secondary-gold/30 shadow-md flex flex-col justify-between gap-5 relative overflow-hidden">
          <!-- Aksen Dekorasi Sudut -->
          <div class="absolute -right-10 -top-10 w-28 h-28 rounded-full bg-secondary-container/30 blur-xl pointer-events-none"></div>

          <div class="flex flex-col gap-4 relative z-10">
            <div class="flex items-center justify-between gap-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container/50 text-on-secondary-container font-label text-[11px] font-bold uppercase tracking-wider">
                <span class="material-symbols-outlined text-[15px]">volunteer_activism</span>
                Infaq & Sedekah Operasional
              </span>
            </div>

            <div class="flex flex-col gap-1">
              <h3 class="font-display text-lg font-bold text-on-surface leading-snug">
                Dukung Operasional & Kemakmuran Masjid
              </h3>
              <p class="font-body text-xs text-on-surface-variant">
                Salurkan sedekah terbaik Anda untuk mendukung kegiatan dakwah dan perawatan Masjid Nurul Taqwa melalui rekening resmi:
              </p>
            </div>

            <!-- Box Bank Syariah Indonesia -->
            <div class="p-4 rounded-xl bg-surface-container-low border border-zinc-200/80 flex flex-col gap-3">
              <!-- Logo BSI dari src/images/ -->
              <div class="flex items-center justify-between border-b border-zinc-200/70 pb-2.5">
                <Image 
                  src={logoBSI} 
                  alt="Logo Bank Syariah Indonesia (BSI)" 
                  class="h-7 w-auto object-contain"
                />
                <span class="font-label text-[11px] font-semibold text-on-surface-variant">Kode Bank: 451</span>
              </div>

              <!-- Nomor Rekening & Copy Button -->
              <div class="flex flex-col gap-1">
                <span class="font-label text-[10px] uppercase tracking-wider text-on-surface-variant">
                  Nomor Rekening BSI
                </span>
                <div class="flex items-center justify-between gap-2">
                  <span id="bsi-rek-number" class="font-display text-xl font-extrabold text-primary tracking-wider tabular-nums">
                    2018041013
                  </span>
                  <button 
                    id="copy-rek-btn"
                    type="button"
                    class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-primary text-on-primary hover:bg-primary-container font-label text-xs font-semibold transition-all active:scale-95 cursor-pointer"
                    aria-label="Salin Nomor Rekening"
                  >
                    <span class="material-symbols-outlined text-[15px]" id="copy-rek-icon">content_copy</span>
                    <span id="copy-rek-text">Salin</span>
                  </button>
                </div>
              </div>

              <!-- Atas Nama -->
              <div class="pt-1 border-t border-zinc-200/60 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-secondary-gold text-[16px]">verified</span>
                <span class="font-body text-xs font-bold text-on-surface">
                  a.n. Yayasan Nurul Taqwa
                </span>
              </div>
            </div>
          </div>

          <a 
            href="#zis" 
            class="w-full py-2.5 px-4 rounded-xl bg-surface-container hover:bg-primary hover:text-on-primary text-primary font-display text-xs font-bold text-center transition-colors flex items-center justify-center gap-1.5"
          >
            <span>Lihat Kalkulator ZIS & QRIS</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </a>
        </div>
      </div>

    </div>

    <!-- BARIS ORGANIZER & POWERED BY (SKI INDOSAT & IOH) -->
    <div class="pt-8 border-t border-zinc-200/80 flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Logo Partner: Organized by SKI & Powered by IOH -->
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-6 sm:gap-10">
        
        <!-- Organized by SKI Indosat -->
        <div class="flex items-center gap-3">
          <div class="bg-white p-2 rounded-xl border border-zinc-200/70 shadow-2xs flex items-center justify-center">
            <Image 
              src={logoSKI} 
              alt="Logo SKI Indosat" 
              class="h-8 w-auto object-contain"
            />
          </div>
          <div class="flex flex-col">
            <span class="font-label text-[10px] uppercase tracking-wider text-on-surface-variant">Organized by</span>
            <span class="font-display text-xs font-bold text-on-surface">SKI Indosat</span>
          </div>
        </div>

        <div class="hidden sm:block h-8 w-px bg-zinc-300/80"></div>

        <!-- Powered by Indosat Ooredoo Hutchison -->
        <div class="flex items-center gap-3">
          <div class="bg-white p-2 rounded-xl border border-zinc-200/70 shadow-2xs flex items-center justify-center">
            <Image 
              src={logoIOH} 
              alt="Logo Indosat Ooredoo Hutchison" 
              class="h-8 w-auto object-contain"
            />
          </div>
          <div class="flex flex-col">
            <span class="font-label text-[10px] uppercase tracking-wider text-on-surface-variant">Powered by</span>
            <span class="font-display text-xs font-bold text-on-surface">Indosat Ooredoo Hutchison</span>
          </div>
        </div>

      </div>

      <!-- Copyright -->
      <div class="text-center md:text-right flex flex-col gap-0.5">
        <p class="font-body text-xs text-on-surface-variant">
          &copy; {new Date().getFullYear()} <strong class="text-on-surface">Masjid Nurul Taqwa</strong>. All rights reserved.
        </p>
        <span class="font-label text-[11px] text-on-surface-variant">
          Yayasan Nurul Taqwa &bull; SKI PT Indosat Tbk
        </span>
      </div>

    </div>

  </div>
</footer>

<!-- Script Copy Nomor Rekening BSI -->
<script is:inline>
  (function initFooterCopy() {
    const copyBtn = document.getElementById('copy-rek-btn');
    const copyText = document.getElementById('copy-rek-text');
    const copyIcon = document.getElementById('copy-rek-icon');
    const rekNumber = '2018041013';

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(rekNumber);
        if (copyText) copyText.innerText = 'Tersalin!';
        if (copyIcon) copyIcon.innerText = 'check';
        copyBtn.classList.replace('bg-primary', 'bg-green-700');

        setTimeout(() => {
          if (copyText) copyText.innerText = 'Salin';
          if (copyIcon) copyIcon.innerText = 'content_copy';
          copyBtn.classList.replace('bg-green-700', 'bg-primary');
        }, 2000);
      } catch (err) {
        console.error('Gagal menyalin nomor rekening:', err);
      }
    });
  })();
</script>
