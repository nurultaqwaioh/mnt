---
import { Image } from 'astro:assets';

// Import aset gambar terupdate dari src/images/ sesuai daftar Anda
import logoBSI from '../images/Bank_Syariah_Indonesia.svg';
import logoSKI from '../images/Logo SKI Color .png';
import logoIOH from '../images/Logo IOH Black Partnership.png';
import qrisMNT from '../images/qris-operasional.png';
---

<!-- BACKGROUND TERBARU: Menggunakan Emerald Hijau Pekat (#033823) yang teduh, flat, dan elegan -->
<footer class="w-full bg-[#033823] text-zinc-100 border-t border-emerald-900/50 pt-12 pb-8" id="kontak">
  <div class="max-w-7xl mx-auto px-margin md:px-margin-md lg:px-margin-lg flex flex-col gap-10">
    
    <!-- MAIN FOOTER GRID (Flat UI Layout - Tanpa Quick Links) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- KOLOM 1 (5/12): Identitas Masjid, Alamat & Sosial Media -->
      <div class="lg:col-span-5 flex flex-col gap-5">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-white/10 text-white flex items-center justify-center shrink-0 border border-white/10">
            <span class="material-symbols-outlined text-[24px] text-[#C5A059]">mosque</span>
          </div>
          <div class="flex flex-col">
            <span class="font-display text-lg font-bold text-white tracking-tight leading-none">
              Masjid Nurul Taqwa
            </span>
            <span class="font-label text-[10px] text-[#C5A059] uppercase tracking-wider font-semibold mt-1">
              Indosat Ooredoo Hutchison
            </span>
          </div>
        </div>

        <p class="font-body text-sm text-zinc-300 leading-relaxed">
          Pusat pembinaan spiritual, dakwah kontemporer, dan pemberdayaan umat di lingkungan Kantor Pusat PT Indosat Tbk.
        </p>

        <!-- Alamat Lengkap (Flat UI Style) -->
        <div class="flex items-start gap-3 py-1">
          <span class="material-symbols-outlined text-[#C5A059] text-[22px] shrink-0 mt-0.5">location_on</span>
          <div class="flex flex-col gap-0.5">
            <span class="font-display text-xs font-bold text-white uppercase tracking-wider">Sekretariat DKM</span>
            <p class="font-body text-xs text-zinc-300 leading-relaxed">
              Jl. Medan Merdeka Barat No. 21, Gambir, Kecamatan Gambir, Kota Jakarta Pusat, DKI Jakarta 10110
            </p>
          </div>
        </div>

        <!-- Social Media (YouTube & Instagram Terupdate) -->
        <div class="flex flex-col gap-2">
          <span class="font-label text-xs font-semibold text-zinc-400 uppercase tracking-wider">
            Media Sosial Resmi
          </span>
          <div class="flex items-center gap-4">
            <!-- YouTube (ROHIS Indosat) -->
            <a 
              href="https://www.youtube.com/@ROHISIndosat" 
              target="_blank" 
              rel="noopener noreferrer"
              aria-label="YouTube ROHIS Indosat"
              class="inline-flex items-center gap-2 text-zinc-300 hover:text-[#FF0000] transition-colors group"
            >
              <svg class="w-5 h-5 fill-current text-[#FF0000]/90 group-hover:text-[#FF0000] transition-colors" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              <span class="font-label text-xs font-semibold">YouTube</span>
            </a>

            <!-- Instagram (SKI Indosat) -->
            <a 
              href="https://www.instagram.com/ski_indosat/" 
              target="_blank" 
              rel="noopener noreferrer"
              aria-label="Instagram SKI Indosat"
              class="inline-flex items-center gap-2 text-zinc-300 hover:text-[#C5A059] transition-colors group"
            >
              <svg class="w-5 h-5 fill-current text-[#C5A059]/90 group-hover:text-[#C5A059] transition-colors" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span class="font-label text-xs font-semibold">Instagram</span>
            </a>
          </div>
        </div>
      </div>

      <!-- KOLOM 2 (3/12): Hubungi Kami (Tanpa Quick Links) -->
      <div class="lg:col-span-3 flex flex-col gap-4">
        <h3 class="font-display text-xs font-bold text-white uppercase tracking-widest border-b border-emerald-800 pb-2">
          Hubungi Kami
        </h3>

        <div class="flex flex-col gap-2.5">
          <!-- Native Email Link -->
          <a 
            href="mailto:masjidnurultaqwa@ioh.co.id" 
            class="flex items-center gap-2.5 text-zinc-300 hover:text-[#C5A059] transition-colors py-1 group"
          >
            <span class="material-symbols-outlined text-[18px]">mail</span>
            <span class="font-body text-xs font-semibold truncate">masjidnurultaqwa@ioh.co.id</span>
          </a>

          <!-- Nomor Hotline 1 -->
          <a 
            href="https://wa.me/6281585079225" 
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 text-zinc-300 hover:text-[#C5A059] transition-colors py-1"
          >
            <span class="material-symbols-outlined text-[18px]">call</span>
            <span class="font-body text-xs font-semibold">+62 815-8507-9225</span>
          </a>

          <!-- Nomor Hotline 2 -->
          <a 
            href="https://wa.me/6285600001567" 
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 text-zinc-300 hover:text-[#C5A059] transition-colors py-1"
          >
            <span class="material-symbols-outlined text-[18px]">support_agent</span>
            <span class="font-body text-xs font-semibold">+62 856-0000-1567</span>
          </a>
        </div>
      </div>

      <!-- KOLOM 3 (4/12): Infaq Bank BSI & QRIS (Flat UI Card) -->
      <div class="lg:col-span-4">
        <div class="rounded-xl bg-white/5 p-5 border border-white/10 flex flex-col gap-4">
          <div class="flex flex-col gap-1">
            <span class="font-label text-[10px] font-bold uppercase tracking-wider text-[#C5A059] flex items-center gap-1">
              <span class="material-symbols-outlined text-[14px]">volunteer_activism</span>
              Infaq Operasional Masjid
            </span>
            <h4 class="font-display text-sm font-bold text-white">Transfer Bank & QRIS</h4>
          </div>

          <!-- Bagian Bank BSI (Flat UI) -->
          <div class="flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <!-- Flat Logo BSI (Tanpa Box Putih) -->
              <Image 
                src={logoBSI} 
                alt="Logo BSI" 
                class="h-6 w-auto object-contain brightness-0 invert"
              />
              <span class="font-label text-[10px] text-zinc-400 font-medium">BSI (451)</span>
            </div>
            <div class="flex items-center justify-between gap-2 bg-white/5 px-3 py-2 rounded-lg border border-white/10">
              <span id="bsi-rek-number" class="font-display text-base font-extrabold text-[#C5A059] tracking-wider tabular-nums">
                2018041013
              </span>
              <button 
                id="copy-rek-btn"
                type="button"
                class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-[#C5A059] text-emerald-950 hover:bg-[#fed488] font-label text-[11px] font-extrabold transition-all active:scale-95 cursor-pointer"
              >
                <span class="material-symbols-outlined text-[13px]" id="copy-rek-icon">content_copy</span>
                <span id="copy-rek-text">Salin</span>
              </button>
            </div>
            <p class="font-body text-[11px] text-zinc-300 font-semibold">a.n. Yayasan Nurul Taqwa</p>
          </div>

          <!-- Divider Flat -->
          <div class="h-px bg-white/10 w-full"></div>

          <!-- Bagian QRIS MNT (Flat UI dengan pemicu Pop-up) -->
          <div class="flex items-center gap-4">
            <!-- Thumbnail QRIS (Bisa diklik untuk memperbesar) -->
            <button 
              id="open-qris-modal" 
              type="button"
              class="w-16 h-16 rounded-lg overflow-hidden bg-white p-1 border border-white/10 shrink-0 hover:scale-105 transition-transform shadow-xs relative group cursor-zoom-in"
              title="Klik untuk memperbesar QRIS"
            >
              <Image 
                src={qrisMNT} 
                alt="QRIS Masjid Nurul Taqwa" 
                class="w-full h-full object-contain"
              />
              <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity text-white">
                <span class="material-symbols-outlined text-[18px]">zoom_in</span>
              </div>
            </button>
            <div class="flex flex-col">
              <button 
                id="open-qris-text-link"
                class="font-display text-xs font-bold text-white hover:text-[#C5A059] transition-colors text-left flex items-center gap-1 cursor-pointer"
              >
                <span>Pindai QRIS Masjid</span>
                <span class="material-symbols-outlined text-[14px]">zoom_in</span>
              </button>
              <p class="font-body text-[11px] text-zinc-300 leading-relaxed">
                Mendukung e-wallet & Mobile Banking. Klik gambar untuk memperbesar QRIS.
              </p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- BARIS ORGANIZER & POWERED BY (Flat UI - Tanpa Box Putih pada Logo) -->
    <div class="pt-6 border-t border-emerald-900/50 flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Logo Partner Flat (Tanpa Box Putih) -->
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-8">
        <!-- SKI Indosat -->
        <div class="flex items-center gap-2.5">
          <Image 
            src={logoSKI} 
            alt="Logo SKI" 
            class="h-7 w-auto object-contain filter brightness-0 invert hover:brightness-100 hover:invert-0 transition-all duration-300"
          />
          <div class="flex flex-col">
            <span class="font-label text-[9px] uppercase tracking-wider text-zinc-400">Organized by</span>
            <span class="font-display text-xs font-bold text-white">SKI Indosat</span>
          </div>
        </div>

        <div class="hidden sm:block h-6 w-px bg-emerald-900/50"></div>

        <!-- IOH -->
        <div class="flex items-center gap-2.5">
          <Image 
            src={logoIOH} 
            alt="Logo IOH" 
            class="h-7 w-auto object-contain filter brightness-0 invert hover:brightness-100 hover:invert-0 transition-all duration-300"
          />
          <div class="flex flex-col">
            <span class="font-label text-[9px] uppercase tracking-wider text-zinc-400">Powered by</span>
            <span class="font-display text-xs font-bold text-white">Indosat Ooredoo Hutchison</span>
          </div>
        </div>

      </div>

      <!-- Copyright -->
      <div class="text-center md:text-right flex flex-col gap-0.5">
        <p class="font-body text-xs text-zinc-300">
          &copy; 2026 <strong class="text-white">Masjid Nurul Taqwa</strong>. All rights reserved.
        </p>
        <span class="font-label text-[10px] text-zinc-400">
          Yayasan Nurul Taqwa &bull; SKI PT Indosat Tbk
        </span>
      </div>

    </div>

  </div>
</footer>

<!-- MODAL POP-UP QRIS (Latar Belakang Semi-Transparan + Blur) -->
<div 
  id="qris-modal" 
  class="fixed inset-0 z-[100] flex items-center justify-center bg-black/75 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300"
  aria-hidden="true"
  role="dialog"
>
  <div class="relative bg-white p-6 rounded-2xl max-w-sm w-[90%] flex flex-col items-center gap-4 shadow-2xl transform scale-95 transition-transform duration-300">
    <!-- Header Modal -->
    <div class="flex items-center justify-between w-full border-b pb-3">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-emerald-900 text-xl">qr_code_2</span>
        <span class="font-display text-sm font-bold text-zinc-800">QRIS Infaq Operasional</span>
      </div>
      <button 
        id="close-qris-modal" 
        type="button" 
        class="w-8 h-8 rounded-full hover:bg-zinc-100 text-zinc-500 hover:text-zinc-800 flex items-center justify-center transition-colors cursor-pointer"
        aria-label="Tutup"
      >
        <span class="material-symbols-outlined text-xl">close</span>
      </button>
    </div>

    <!-- Gambar QRIS Besar -->
    <div class="w-72 h-72 rounded-xl border p-2 bg-white shadow-inner flex items-center justify-center">
      <Image 
        src={qrisMNT} 
        alt="QRIS Masjid Nurul Taqwa Besar" 
        class="w-full h-full object-contain"
      />
    </div>

    <!-- Informasi / Keterangan -->
    <div class="text-center flex flex-col gap-1">
      <span class="font-display text-xs font-bold text-emerald-900">a.n. YAYASAN NURUL TAQWA</span>
      <p class="font-body text-[11px] text-zinc-500">
        Silakan pindai QRIS di atas menggunakan mobile banking atau aplikasi e-wallet Anda.
      </p>
    </div>
  </div>
</div>

<script is:inline>
  // 1. Logika Salin Nomor Rekening BSI
  (function initFooterCopy() {
    const copyBtn = document.getElementById('copy-rek-btn');
    const copyText = document.getElementById('copy-rek-text');
    const copyIcon = document.getElementById('copy-rek-icon');
    const rekNumber = '2018041013';

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(rekNumber);
        if (copyText) copyText.innerText = 'Tersalin!';
        if (copyIcon) copyIcon.innerText = 'check';
        copyBtn.classList.replace('bg-[#C5A059]', 'bg-green-700');
        copyBtn.classList.replace('text-emerald-950', 'text-white');

        setTimeout(() => {
          if (copyText) copyText.innerText = 'Salin';
          if (copyIcon) copyIcon.innerText = 'content_copy';
          copyBtn.classList.replace('bg-green-700', 'bg-[#C5A059]');
          copyBtn.classList.replace('text-white', 'text-emerald-950');
        }, 2000);
      } catch (err) {
        console.error('Gagal menyalin nomor rekening:', err);
      }
    });
  })();

  // 2. Logika Modal Pop-up QRIS
  (function initQrisModal() {
    const openBtn = document.getElementById('open-qris-modal');
    const openLink = document.getElementById('open-qris-text-link');
    const closeBtn = document.getElementById('close-qris-modal');
    const modal = document.getElementById('qris-modal');
    const modalContent = modal?.querySelector('div');

    function openModal() {
      if (!modal) return;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      modalContent?.classList.remove('scale-95');
      modalContent?.classList.add('scale-100');
      document.body.style.overflow = 'hidden'; // Kunci scroll halaman utama
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modalContent?.classList.remove('scale-100');
      modalContent?.classList.add('scale-95');
      document.body.style.overflow = ''; // Aktifkan scroll kembali
    }

    openBtn?.addEventListener('click', openModal);
    openLink?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);

    // Tutup ketika mengeklik area gelap di luar modal
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Tutup menggunakan tombol Escape di keyboard
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('opacity-0')) {
        closeModal();
      }
    });
  })();
</script>
