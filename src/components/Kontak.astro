<section class="w-full py-space-2xl bg-surface" id="kontak">
  <div class="max-w-7xl mx-auto px-margin md:px-margin-md lg:px-margin-lg flex flex-col gap-space-xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg">
      <div class="lg:col-span-6 flex flex-col gap-4">
        <h2 class="font-display text-2xl font-bold text-on-surface">Sekretariat SKI Indosat</h2>
        <p class="text-sm text-on-surface-variant">Lantai Dasar Masjid Nurul Taqwa Gedung Pusat PT Indosat Tbk, Jl. Medan Merdeka Barat No.11, Jakarta Pusat.</p>
        <span class="font-label text-sm text-primary font-bold">Hotline: +62 857-7310-1357</span>
      </div>

      <div class="lg:col-span-6 bg-surface-container-lowest p-6 rounded-2xl shadow-lg border border-zinc-100">
        <h3 class="font-display font-bold text-lg mb-4">Kirim Pertanyaan</h3>
        <form class="flex flex-col gap-4">
          <input class="p-2.5 border rounded-lg w-full" type="text" placeholder="Nama Lengkap" />
          <input class="p-2.5 border rounded-lg w-full" type="email" placeholder="Alamat Email" />
          <textarea class="p-2.5 border rounded-lg w-full" rows="3" placeholder="Pesan Anda"></textarea>
          <button class="py-2.5 bg-primary text-on-primary font-bold rounded-lg" type="submit">Kirim Pesan</button>
        </form>
      </div>
    </div>
  </div>
</section>
