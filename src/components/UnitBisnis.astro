<section class="w-full py-space-2xl bg-surface-container-low" id="unit-bisnis">
  <div class="max-w-7xl mx-auto px-margin md:px-margin-md lg:px-margin-lg flex flex-col gap-space-xl">
    <div class="flex flex-col gap-space-xs max-w-2xl">
      <span class="font-label text-xs text-secondary-gold uppercase tracking-widest font-bold">Kemandirian Finansial</span>
      <h2 class="font-display text-3xl font-bold text-on-surface">Unit Usaha Masjid</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter-lg">
      <div class="rounded-2xl bg-surface-container-lowest overflow-hidden shadow-sm">
        <div class="h-48 bg-zinc-300"></div>
        <div class="p-space-lg">
          <h3 class="font-display text-lg font-bold">Taqwa Mart & Sembako</h3>
          <p class="text-sm text-on-surface-variant mt-2">Menyediakan aneka kebutuhan pokok halal dan kebutuhan harian jamaah.</p>
        </div>
      </div>
      <div class="rounded-2xl bg-surface-container-lowest overflow-hidden shadow-sm">
        <div class="h-48 bg-zinc-300"></div>
        <div class="p-space-lg">
          <h3 class="font-display text-lg font-bold">Taqwa Coffee Corner</h3>
          <p class="text-sm text-on-surface-variant mt-2">Ruang diskusi hangat dengan sajian kopi Nusantara pilihan karyawan.</p>
        </div>
      </div>
      <div class="rounded-2xl bg-surface-container-lowest overflow-hidden shadow-sm">
        <div class="h-48 bg-zinc-300"></div>
        <div class="p-space-lg">
          <h3 class="font-display text-lg font-bold">Aula & Hall Rental</h3>
          <p class="text-sm text-on-surface-variant mt-2">Fasilitas akad nikah syar'i dan gathering korporat bernuansa islami.</p>
        </div>
      </div>
    </div>
  </div>
</section>
